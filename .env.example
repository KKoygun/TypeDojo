# AI review is optional. Without these settings the curriculum runs fine; AI insight and evaluation are off.

# groq (default) | gemini | claude | openai | ollama
AI_PROVIDER=groq

# One key per provider, so one .env can hold several and AI_PROVIDER picks between them.
#   GROQ_API_KEY       free at https://console.groq.com
#   GEMINI_API_KEY     free at https://aistudio.google.com/apikey
#   ANTHROPIC_API_KEY  https://console.anthropic.com (separate from a Claude.ai plan)
#   OPENAI_API_KEY     https://platform.openai.com (separate from a ChatGPT plan)
#   ollama needs no key; set OLLAMA_HOST if it is not on localhost:11434
GROQ_API_KEY=your_groq_key_here

# There is no default model. npm run models lists the ones your key can use.
AI_MODEL=
